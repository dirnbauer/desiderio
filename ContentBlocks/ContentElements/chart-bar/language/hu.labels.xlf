<?xml version="1.0" encoding="utf-8"?>
<xliff version="2.0" xmlns="urn:oasis:names:tc:xliff:document:2.0" srcLang="en" trgLang="hu">
  <file id="chart-bar">
    <unit id="table.category">
      <segment state="final">
        <source>Category</source>
        <target>Kategória</target>
      </segment>
    </unit>
    <unit id="table.value">
      <segment state="final">
        <source>Value</source>
        <target>Érték</target>
      </segment>
    </unit>
    <unit id="table.total">
      <segment state="final">
        <source>Total</source>
        <target>Összesen</target>
      </segment>
    </unit>
    <unit id="stat.top">
      <segment state="final">
        <source>Top</source>
        <target>Legmagasabb</target>
      </segment>
    </unit>
    <unit id="stat.total">
      <segment state="final">
        <source>Total</source>
        <target>Összesen</target>
      </segment>
    </unit>
    <unit id="stat.lowest">
      <segment state="final">
        <source>Lowest</source>
        <target>Legalacsonyabb</target>
      </segment>
    </unit>
    <unit id="stat.top_share">
      <segment state="final">
        <source>Top share</source>
        <target>Legnagyobb arány</target>
      </segment>
    </unit>
    <unit id="aria.fallback">

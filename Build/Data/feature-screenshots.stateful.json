        {
            "name": "feature-jev-playground",
            "kind": "backend",
            "url": "/typo3/module/webcon-jev/decisions",
            "viewport": "1600x1100",
            "steps": [
                {
                    "waitFor": "table tbody tr",
                    "frame": true,
                    "timeout": 120000
                },
                {
                    "evaluate": "(() => { const row = [...document.querySelectorAll(\"table tbody tr\")].find((tr) => /Support/.test(tr.innerText)); const a = [...row.querySelectorAll(\"a\")].find((x) => /playground/i.test(x.innerText + x.title)); location.href = a.href; })()",
                    "frame": true,
                    "wait": 1500
                },
                {
                    "waitFor": "#webcon-jev-playground textarea",
                    "frame": true,
                    "timeout": 120000
                },
                {
                    "fill": [
                        "#webcon-jev-playground textarea >> nth=0",
                        "Desiderio 4.9 on TYPO3 v14"
                    ],
                    "frame": true
                },
                {
                    "fill": [
                        "#webcon-jev-playground textarea >> nth=1",
                        "Since the update, saving a page in the Visual Editor shows a blank screen and my changes are gone. It happens every time, in Chrome and Firefox. Our editors cannot publish anything today."
                    ],
                    "frame": true
                },
                {
                    "click": "#webcon-jev-playground button:has-text(\"Run\")",
                    "frame": true
                },
                {
                    "waitFor": "text=Probabilities for severity",
                    "frame": true,
                    "timeout": 120000
                },
                {
                    "evaluate": "document.activeElement && document.activeElement.blur()",
                    "frame": true,
                    "wait": 600
                },
                {
                    "evaluate": "(() => { const hide = (el) => { el.style.filter = \"blur(5px)\"; }; document.querySelectorAll(\"input, textarea\").forEach((field) => { if (/@/.test(field.value)) { hide(field); } }); const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT); const found = []; while (walker.nextNode()) { if (/@/.test(walker.currentNode.textContent)) { found.push(walker.currentNode.parentElement); } } found.forEach(hide); })()",
                    "frame": true,
                    "wait": 400,
                    "note": "Blurs the routing addresses: they are real mailboxes."
                },
                {
                    "evaluate": "document.querySelector(\"#webcon-jev-playground\").scrollIntoView({ block: \"end\" })",
                    "frame": true,
                    "wait": 600
                }
            ],
            "clip": "module",
            "anchor": "bottom"
        },

#!/usr/bin/env bash

# Desiderio pre-commit hook.
# Activated by running Build/Scripts/setup-hooks.sh (which sets git
# core.hooksPath = Build/Hooks).
#
# Check rendering code and build dependencies without duplicating Tailwind's
# @source list. Documentation-only and test-only commits need no CSS rebuild.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
if git diff --cached --quiet -- Classes Configuration ContentBlocks Resources \
    package.json package-lock.json; then
  exit 0
fi

echo "pre-commit: rebuilding Tailwind bundle to check it stays in sync..." >&2
Build/Scripts/runTests.sh -s tailwind
if ! git diff --quiet -- Resources/Public/Css/desiderio-tailwind.css; then
  echo "pre-commit: stage Resources/Public/Css/desiderio-tailwind.css before committing." >&2
  exit 1
fi

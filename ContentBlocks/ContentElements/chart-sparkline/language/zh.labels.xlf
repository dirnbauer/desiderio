<?xml version="1.0" encoding="utf-8"?>
<xliff version="2.0" xmlns="urn:oasis:names:tc:xliff:document:2.0" srcLang="en" trgLang="zh">
  <file id="chart-sparkline">
    <unit id="aria.fallback">
      <segment state="final">
        <source>Sparkline</source>
        <target>迷你走势图</target>
      </segment>
    </unit>
    <unit id="aria.summary">
      <segment state="final">
        <source>{title}: {series} sparkline across {count, plural, one {# point} other {# points}} from {first} to {last}{latest}. The full series follows in the data table.</source>
        <target>{title}：{series} 迷你走势图，共 {count, plural, one {# 个数据点} other {# 个数据点}}，从 {first} 到 {last}{latest}。完整数据系列见下方数据表。</target>
      </segment>
    </unit>
    <unit id="aria.summary.latest">
      <segment state="final">
        <source>, latest {value} at {label}</source>
        <target>，最新值为 {value}（{label}）</target>
      </segment>
    </unit>
    <unit id="table.period">
      <segment state="final">
        <source>Period</source>
        <target>时段</target>
      </segment>
    </unit>
    <unit id="table.net_change">
      <segment state="final">
        <source>Net change (first to last)</source>
        <target>净变化（首值到末值）</target>
      </segment>
    </unit>
  </file>
</xliff>

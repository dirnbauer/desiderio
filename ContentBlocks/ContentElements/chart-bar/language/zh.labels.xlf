<?xml version="1.0" encoding="utf-8"?>
<xliff version="2.0" xmlns="urn:oasis:names:tc:xliff:document:2.0" srcLang="en" trgLang="zh">
  <file id="chart-bar">
    <unit id="table.category">
      <segment state="final">
        <source>Category</source>
        <target>类别</target>
      </segment>
    </unit>
    <unit id="table.value">
      <segment state="final">
        <source>Value</source>
        <target>数值</target>
      </segment>
    </unit>
    <unit id="table.total">
      <segment state="final">
        <source>Total</source>
        <target>总计</target>
      </segment>
    </unit>
    <unit id="stat.top">
      <segment state="final">
        <source>Top</source>
        <target>最高</target>
      </segment>
    </unit>
    <unit id="stat.total">
      <segment state="final">
        <source>Total</source>
        <target>总计</target>
      </segment>
    </unit>
    <unit id="stat.lowest">
      <segment state="final">
        <source>Lowest</source>
        <target>最低</target>
      </segment>
    </unit>
    <unit id="stat.top_share">
      <segment state="final">
        <source>Top share</source>
        <target>最高占比</target>
      </segment>
    </unit>
    <unit id="aria.fallback">
      <segment state="final">
        <source>Bar chart</source>
        <target>条形图</target>
      </segment>
    </unit>
    <unit id="aria.summary">
      <segment state="final">
        <source>{title}: bar chart comparing {count, plural, one {# category} other {# categories}}{measuring}. The full breakdown follows in the data table.</source>
        <target>{title}：条形图，比较 {count, plural, one {# 个类别} other {# 个类别}}{measuring}。完整明细见下方数据表。</target>
      </segment>
    </unit>
    <unit id="aria.summary.measuring">
      <segment state="final">
        <source>, measuring {series}</source>
        <target>，数据系列：{series}</target>
      </segment>
    </unit>
  </file>
</xliff>

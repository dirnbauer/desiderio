            "name": "frontend-feature-sg-apicore-try-it",
            "kind": "frontend",
            "url": "/api/public/v1/docs/ui#/pages/get_pages",
            "viewport": "1440x1000",
            "steps": [
                {
                    "click": ".theme-switcher .btn-light"
                },
                {
                    "waitFor": "#operations-pages-get_pages .try-out__btn"

{
  "name": "desiderio",
  "private": true,
  "version": "4.2.0",
  "description": "Tailwind v4 and shadcn/ui theme build for the Desiderio TYPO3 extension.",
  "scripts": {
    "build": "npm run build:presets && npm run build:preset-overview && npm run build:css && npm run build:desiderio-css && npm run build:prism && npm run build:hljs && npm run build:iconfonts",
    "build:presets": "php Build/Scripts/generate-shadcn-presets.php",
    "build:preset-overview": "php Build/Scripts/build-preset-overview.php",
    "build:css": "tailwindcss -i Resources/Private/Tailwind/desiderio.css -o Resources/Public/Css/desiderio-tailwind.css --minify && npm run build:fonts",
    "build:desiderio-css": "node Build/Scripts/build-desiderio-css.mjs",
    "build:prism": "node Build/Scripts/build-prism-lite.mjs",
    "build:hljs": "node Build/Scripts/build-hljs-lite.mjs",
    "build:iconfonts": "node Build/Scripts/sync-icon-fonts.mjs",
    "build:hugeicons-font": "node Build/Scripts/build-hugeicons-font.mjs",
    "watch:css": "tailwindcss -i Resources/Private/Tailwind/desiderio.css -o Resources/Public/Css/desiderio-tailwind.css --watch",
    "shadcn:info": "shadcn info --json",
    "shadcn:sync-fluid": "php Build/Scripts/sync-shadcn-fluid-primitives.php",
    "registry:build": "shadcn build --output Resources/Public/ShadcnRegistry",
    "build:fonts": "node Build/Scripts/sync-fonts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "@tabler/icons-webfont": "^3.49.0",
    "@tailwindcss/cli": "^4.3.3",
    "lucide-static": "^1.61.0",
    "prismjs": "^1.30.0",
    "remixicon": "^4.9.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@highlightjs/cdn-assets": "^11.12.0",
    "@hugeicons/core-free-icons": "4.2.0",
    "@playwright/test": "^1.64.1",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "fantasticon": "^4.1.0"
  }
}

        {
            "name": "frontend-feature-agentation-frontend-note",
            "kind": "frontend-auth",
            "url": "/",
            "viewport": "1440x900",
            "waitUntil": "domcontentloaded",
            "css": "#typo3-preview-info,#TSFE_ADMIN_PANEL_FORM,.typo3-adminPanel{display:none!important}",
            "steps": [
                {
                    "waitFor": "agentation-toolbar button[aria-label=\"Start feedback mode\"]",
                    "timeout": 180000,
                    "wait": 1500
                },
                {
                    "evaluate": "(() => { const mark = (el, name) => el && el.setAttribute(\"data-shot-target\", name); const visible = (e) => { const r = e.getBoundingClientRect(); return r.width > 50 && r.height > 20 && r.top >= 0 && r.bottom <= innerHeight; }; mark([...document.querySelectorAll(\"h1,h2,h3\")].filter(visible).sort((a, b) => parseFloat(getComputedStyle(b).fontSize) - parseFloat(getComputedStyle(a).fontSize))[0], \"headline\"); mark([...document.querySelectorAll(\"a,button\")].find((e) => visible(e) && /get started/i.test(e.textContent)), \"button\"); mark([...document.querySelectorAll(\"main img\")].find(visible), \"image\"); })()"
                },
                {
                    "click": "agentation-toolbar button[aria-label=\"Start feedback mode\"]",
                    "wait": 900
                },
                {
                    "click": "[data-shot-target=headline]",
                    "wait": 900
                },
                {
                    "fill": [
                        "agentation-toolbar textarea[placeholder=\"What should change?\"]",
                        "Keep \u201celements for TYPO3\u201d together: break the line after \u201ccontent\u201d."
                    ]
                },
                {
                    "click": "agentation-toolbar button[class*=submit]",
                    "wait": 900
                },
                {
                    "click": "[data-shot-target=button]",
                    "wait": 900
                },
                {
                    "fill": [
                        "agentation-toolbar textarea[placeholder=\"What should change?\"]",
                        "Use the brand colour here, so it stands out from See the features."
                    ]
                },
                {
                    "click": "agentation-toolbar button[class*=submit]",
                    "wait": 900
                },
                {
                    "click": "[data-shot-target=image]",
                    "wait": 900
                },
                {
                    "fill": [
                        "agentation-toolbar textarea[placeholder=\"What should change?\"]",
                        "Add a short caption under this preview"
                    ]
                },
                {
                    "evaluate": "document.activeElement && document.activeElement.blur && 0",
                    "wait": 600
                }
            ],
            "clip": "viewport"
        },

                    ]
                },
                {
                    "fill": [
                        "#operations-pages-get_pages tr[data-param-name=\"filter\"] textarea",
                        "{\"pid\": 1068}"
                    ]
                },
                {
                    "click": "#operations-pages-get_pages .execute"

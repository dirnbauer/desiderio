@import 'EXT:solr/Configuration/TypoScript/Solr/setup.typoscript'
@import 'EXT:solr/Configuration/TypoScript/Examples/EverythingOn/setup.typoscript'
@import 'EXT:solr/Configuration/TypoScript/Examples/IndexQueueNews/setup.typoscript'

# Keep EverythingOn's Solr features enabled without dumping raw debug output into the frontend response.
plugin.tx_solr.logging.debugOutput = 0
# EverythingOn also turns on site highlighting, which appends sword_list[] and
# no_cache to every result link. TYPO3 v14 validates the cHash of any query
# string (cacheHash.enforceValidation), so those links answered 404.
plugin.tx_solr.search.results.siteHighlighting = 0
# EverythingOn also enables debugQuery/echoParams on every Solr request and logs the full
# query + response payload per request — ~1.3s extra per suggest keystroke. Keep both off.
plugin.tx_solr.enableDebugMode = 0
plugin.tx_solr.logging.query {
  filters = 0
  searchWords = 0
  queryString = 0
  rawPost = 0
  rawGet = 0
}
plugin.tx_solr.logging.indexing.queue {
  tt_news >
  news = 1
  tx_news = 1
  tt_address = 1
}
plugin.tx_solr.index.queue.news.fields {
  rootline.data = siteSettings:news.pages.detail // site:rootPageId
  url.default.typolink.parameter.data = siteSettings:news.pages.detail // site:rootPageId
}

# The sites of one installation share their Solr cores. Facet options are
# counted per query, but with minimumCount = 0 Solr also returns every value
# the field has anywhere in the core: the content type and category facets of
# one site listed other sites' values at 0 (the blog's "News" category, a
# retired skill type of the corporate starter). minimumCount = 1 keeps a facet
# to the values this site's results actually have.
plugin.tx_solr.search.faceting {
  minimumCount = 1
  keepAllFacetsOnSelection = 1

  facets {
    type {
      # A plain label is printed as it is; TEXT with data = LLL translates it.
      label = TEXT
      label.data = LLL:EXT:desiderio/Resources/Private/Language/labels.xlf:solr.facet.type
      field = type
      partialName = Options
      minimumCount = 1
      # Multi-select semantics: ticking a second type WIDENS the result set
      # (pages OR news), and every option keeps the count it would have on its
      # own — which is what makes a checkbox group behave as visitors expect.
      operator = OR
      keepAllOptionsOnSelection = 1
      manualSortOrder = pages,tx_news_domain_model_news,tx_nrllm_skill
      renderingInstruction = CASE
      renderingInstruction {
        key.field = optionValue

        default = TEXT
        default.field = optionValue

        pages = TEXT
        pages.data = LLL:EXT:desiderio/Resources/Private/Language/labels.xlf:solr.contentType.pages

        tx_news_domain_model_news = TEXT
        tx_news_domain_model_news.data = LLL:EXT:desiderio/Resources/Private/Language/labels.xlf:solr.contentType.news

        # EXT:skillflow indexes the skill records of nr_llm, so a skill
        # document's type is their table, tx_nrllm_skill. Without this entry
        # the facet printed the raw table name.
        tx_nrllm_skill = TEXT
        tx_nrllm_skill.data = LLL:EXT:desiderio/Resources/Private/Language/labels.xlf:solr.contentType.skills

        # Older skillflow versions indexed their own table.
        tx_skillflow_skill < .tx_nrllm_skill
      }
    }

    # Categories of the indexed records. `category_stringM` is filled by the
    # IndexQueueNews configuration imported above (SOLR_RELATION over the
    # `categories` field), so the facet appears as soon as categorized records
    # are indexed and stays empty — not broken — when there are none.
    category {
      # EXT:solr prints a plain label as it is, so an LLL reference showed up
      # raw; TEXT with data = LLL resolves it in the page's language.
      label = TEXT
      label.data = LLL:EXT:desiderio/Resources/Private/Language/labels.xlf:solr.facet.category
      field = category_stringM
      partialName = Options
      minimumCount = 1
      operator = OR
      keepAllOptionsOnSelection = 1
      sortBy = count
    }
  }
}

# Frequent searches (EverythingOn turns them on): a short list of the terms
# searched most often, not EXT:solr's twenty-term cloud, and never the bare
# wildcard, which only says that someone pressed search on an empty field.
plugin.tx_solr.search.frequentSearches {
  limit = 8
  select.ADD_WHERE = AND num_found != 0 AND keywords <> '*'
}

# EXT:solr 12+ ships jQuery-free vanilla controllers; only the facet
# show-more/filter controller is needed (suggest is desiderio's own).
page.includeJSFooterlibs {
  solr-options = EXT:solr/Resources/Public/JavaScript/facet_options_controller.js
  # Turns the facet checkboxes into one-click filters; the markup works
  # without it through the <noscript> links.
  desiderio-solr-facets = EXT:desiderio/Resources/Public/Js/solr-facets.js
}

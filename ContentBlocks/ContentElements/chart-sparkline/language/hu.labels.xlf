<?xml version="1.0" encoding="utf-8"?>
<xliff version="2.0" xmlns="urn:oasis:names:tc:xliff:document:2.0" srcLang="en" trgLang="hu">
  <file id="chart-sparkline">
    <unit id="aria.fallback">
      <segment state="final">
        <source>Sparkline</source>
        <target>Mini vonaldiagram</target>
      </segment>
    </unit>
    <unit id="aria.summary">
      <segment state="final">
        <source>{title}: {series} sparkline across {count, plural, one {# point} other {# points}} from {first} to {last}{latest}. The full series follows in the data table.</source>
        <target>{title}: {series}, mini vonaldiagram, {count, plural, one {# adatpont} other {# adatpont}}, {first} és {last} között{latest}. A teljes adatsort az adattáblázat tartalmazza.</target>
      </segment>
    </unit>
    <unit id="aria.summary.latest">
      <segment state="final">
        <source>, latest {value} at {label}</source>
        <target>, legutóbbi érték: {value} ({label})</target>
      </segment>
    </unit>
    <unit id="table.period">
      <segment state="final">
        <source>Period</source>
        <target>Időszak</target>
      </segment>
    </unit>
    <unit id="table.net_change">
      <segment state="final">
        <source>Net change (first to last)</source>
        <target>Nettó változás (az elsőtől az utolsóig)</target>
      </segment>
    </unit>
  </file>
</xliff>

                {
                    "waitFor": "#operations-pages-get_pages .live-responses-table",
                    "timeout": 60000
                },
                {
                    "scroll": "#operations-pages-get_pages .live-responses-table"
                },
                {
                    "evaluate": "document.querySelectorAll('.theme-switcher').forEach((e) => e.remove())",
                    "wait": 300
                }
            ],
            "clip": "#operations-pages-get_pages .live-responses-table"

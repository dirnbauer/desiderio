            "name": "frontend-feature-sg-apicore-swagger",
            "kind": "frontend",
            "url": "/api/public/v1/docs/ui",
            "viewport": "1440x1100",
            "steps": [
                {
                    "click": ".theme-switcher .btn-light"
                },
                {
                    "click": "h3#operations-tag-Examples"
                },
                {
                    "click": "h3#operations-tag-Legacy"
                },
                {
                    "evaluate": "window.scrollTo(0, 0)",
                    "wait": 800
                },
                {
                    "evaluate": "document.querySelectorAll('.theme-switcher').forEach((e) => e.remove())",
                    "wait": 300
                }
            ],
            "clip": "viewport"
        },

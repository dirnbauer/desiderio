# Use PAGEVIEW to render page templates (enables visual-editor content areas)
lib.desiderioPageDataProcessing {
  10 = menu
  10 {
    as = mainMenu
    special = directory
    special.value.data = site:rootPageId
    levels = 2
    expandAll = 1
    titleField = nav_title // title
  }

  20 = menu
  20 {
    special = rootline
    as = breadcrumb
    # Keep the current page in the trail even when it is flagged
    # "hide in menu" (nav_hide), e.g. the Search page. Without this the
    # rootline menu drops the nav_hidden leaf, the trail collapses to just
    # "Home", and the layout suppresses a single-item breadcrumb.
    includeNotInMenu = 1
    titleField = nav_title // title
    dataProcessing.10 = record-transformation
  }

  30 = language-menu
  30 {
    as = languageNavigation
    languages = auto
  }

  40 = site
  40.as = site

  60 = menu
  60 {
    if.isTrue = {$desiderio.footer.legalPageIds}
    special = list
    special.value = {$desiderio.footer.legalPageIds}
    as = legalMenu
    includeNotInMenu = 1
    titleField = nav_title // title
  }
}

# Registry: "the content of this page renders the page's h1". Every entry is a
# cObject that outputs something when its content owns the heading; page
# templates then leave out their page-title h1 (d:organism.pageHeader), so the
# document keeps exactly one h1. Desiderio uses keys 10-99; extensions and site
# packages add their own key (100 and up, unique to them), e.g.
#
#   lib.pageHeadingOwnedByContent.110 = TEXT
#   lib.pageHeadingOwnedByContent.110 {
#     value = 1
#     if.value = 1066,1067
#     if.isInList.data = page:uid
#   }
#
# Only the type is assigned here, never cleared with ">": entries that
# ext_localconf.php or earlier sets added (EXT:skillflow registers its skill
# detail plugin) survive.
lib.pageHeadingOwnedByContent = COA
lib.pageHeadingOwnedByContent {
  # A routed EXT:news detail view: the article headline is the h1.
  10 = TEXT
  10 {
    value = 1
    if.isTrue.data = GP:tx_news_pi1|news
  }
}

lib.fluidPage >
lib.fluidPage = PAGEVIEW
lib.fluidPage {
  paths.10 = EXT:desiderio/Resources/Private/Templates/
  dataProcessing < lib.desiderioPageDataProcessing

  # uid of the news article when a detail view renders on this page (the
  # Extbase route enhancer carries it in the tx_news_pi1 namespace; 0
  # otherwise). Page templates with their own page-title band check it and
  # stand down, so the article's h1 leads the document instead of the page
  # title.
  variables.newsDetailUid = TEXT
  variables.newsDetailUid {
    data = GP:tx_news_pi1|news
    intval = 1
  }

  # "1" when an entry of lib.pageHeadingOwnedByContent renders something,
  # "" otherwise. Page templates pass it to d:organism.pageHeader, which then
  # stands down. The reference resolves at render time, so entries added after
  # this set still count.
  variables.pageHeadingOwnedByContent = TEXT
  variables.pageHeadingOwnedByContent {
    value = 1
    if.isTrue.cObject =< lib.pageHeadingOwnedByContent
  }
}

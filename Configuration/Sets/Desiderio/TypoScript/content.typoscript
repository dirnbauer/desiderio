# Content element rendering.
#
# These root paths ARE the registration — there is no styles.templates.* site
# setting behind them. A sitepackage overrides Desiderio's classic content
# rendering by adding its own paths on a higher index, e.g.
#
#   lib.contentElement.templateRootPaths.300 = EXT:my_sitepackage/Resources/Private/Content/Templates/
#   lib.contentElement.partialRootPaths.300  = EXT:my_sitepackage/Resources/Private/Content/Partials/
#   lib.contentElement.layoutRootPaths.300   = EXT:my_sitepackage/Resources/Private/Content/Layouts/
#
# Index 300 is reserved for sitepackages; Desiderio never writes it.
lib.contentElement = FLUIDTEMPLATE
lib.contentElement {
  # The ClassicContent path owns the classic TYPO3 CTypes and follows the same
  # shadcn/Fluid 5 recipe as Content Blocks. The retired legacy Templates/Content/
  # set has been removed; the .10 layout/partial paths still serve shared page/preset partials.
  layoutRootPaths.10 = EXT:desiderio/Resources/Private/Templates/Layouts/
  layoutRootPaths.200 = EXT:desiderio/Resources/Private/ClassicContent/Layouts/
  partialRootPaths.10 = EXT:desiderio/Resources/Private/Templates/Partials/
  partialRootPaths.200 = EXT:desiderio/Resources/Private/ClassicContent/Partials/
  templateRootPaths.200 = EXT:desiderio/Resources/Private/ClassicContent/Templates/

  templateName >
  templateName.ifEmpty.cObject = TEXT
  templateName.ifEmpty.cObject {
    field = CType
    required = 1
    case = uppercamelcase
  }

  dataProcessing.1421884800 = record-transformation
}

lib.desiderioContentWithBullets =< lib.contentElement
lib.desiderioContentWithBullets {
  dataProcessing.20 = split
  dataProcessing.20 {
    if.isTrue.field = bodytext
    fieldName = bodytext
    as = bullets
    removeEmptyEntries = 1
  }
}

lib.desiderioContentWithTable =< lib.contentElement
lib.desiderioContentWithTable {
  dataProcessing.20 = comma-separated-value
  dataProcessing.20 {
    if.isTrue.field = bodytext
    fieldName = bodytext
    # table_delimiter/table_enclosure store ASCII codes (124 = "|"); they must
    # be converted to the actual character or fgetcsv() rejects the separator.
    # Preserves TYPO3's classic table behaviour, including skipping the
    # enclosure entirely when it is 0 ("none").
    fieldDelimiter.char.cObject = TEXT
    fieldDelimiter.char.cObject {
      field = table_delimiter
    }
    fieldEnclosure.char.cObject = TEXT
    fieldEnclosure.char.cObject {
      field = table_enclosure
    }
    fieldEnclosure {
      if {
        value = 0
        equals.field = table_enclosure
        negate = 1
      }
    }
    # cols is the table's column count (0 = all); imagecols belongs to images.
    maximumColumns.field = cols
    as = table
  }
}

lib.desiderioMenuSelectedPages =< lib.contentElement
lib.desiderioMenuSelectedPages {
  dataProcessing.20 = menu
  dataProcessing.20 {
    special = list
    special.value.field = pages
    as = menu
    titleField = nav_title // title
  }
}

lib.desiderioMenuSubpages =< lib.contentElement
lib.desiderioMenuSubpages {
  dataProcessing.20 = menu
  dataProcessing.20 {
    special = directory
    special.value.field = pages
    as = menu
    levels = 2
    expandAll = 1
    titleField = nav_title // title
  }
}

lib.desiderioMenuRecentlyUpdated =< lib.contentElement
lib.desiderioMenuRecentlyUpdated {
  dataProcessing.20 = menu
  dataProcessing.20 {
    special = updated
    as = menu
    titleField = nav_title // title
  }
}

lib.desiderioShortcutRecords = RECORDS
lib.desiderioShortcutRecords {
  source.current = 1
  tables = tt_content
  dontCheckPid = 1
}

tt_content.default =< lib.contentElement

# Keep EXT:visual_editor's content-element wrapper on the existing content
# renderer while preserving extension-provided plugin CTypes.
tt_content.stdWrap.wrapContentElementsWithVeWrapper = 1

tt_content.header =< lib.contentElement
tt_content.text =< lib.contentElement
tt_content.textpic =< lib.contentElement
tt_content.textpic {
  dataProcessing.10 = files
  dataProcessing.10.references.fieldName = image
}

tt_content.textmedia =< lib.contentElement
tt_content.textmedia {
  dataProcessing.10 = files
  dataProcessing.10.references.fieldName = assets
}

tt_content.image =< lib.contentElement
tt_content.image {
  dataProcessing.10 = files
  dataProcessing.10.references.fieldName = image
}

tt_content.uploads =< lib.contentElement
tt_content.uploads {
  dataProcessing.10 = files
  dataProcessing.10 {
    references.fieldName = media
    collections.field = file_collections
    sorting.field = filelink_sorting
    sorting.direction.field = filelink_sorting_direction
  }
}
tt_content.bullets =< lib.desiderioContentWithBullets
tt_content.table =< lib.desiderioContentWithTable
tt_content.div =< lib.contentElement
tt_content.html =< lib.contentElement
tt_content.shortcut =< lib.contentElement

tt_content.menu_pages =< lib.desiderioMenuSelectedPages
tt_content.menu_abstract =< lib.desiderioMenuSelectedPages
tt_content.menu_related_pages =< lib.desiderioMenuSelectedPages
tt_content.menu_sitemap =< lib.desiderioMenuSubpages
tt_content.menu_sitemap_pages =< lib.desiderioMenuSubpages
tt_content.menu_subpages =< lib.desiderioMenuSubpages
tt_content.menu_section =< lib.desiderioMenuSubpages
tt_content.menu_section_pages =< lib.desiderioMenuSubpages
tt_content.menu_categorized_pages =< lib.desiderioMenuSelectedPages
tt_content.menu_categorized_content =< lib.contentElement
# Core's definition inlines field:selected_categories into "IN(|)" — with no
# categories selected that becomes IN(), a SQL syntax error, i.e. a 500 the
# moment an editor inserts the element without picking categories. Skip the
# query processor instead; the template then renders an empty menu.
tt_content.menu_categorized_content.dataProcessing.10.if.isTrue.field = selected_categories
tt_content.menu_recently_updated =< lib.desiderioMenuRecentlyUpdated

tt_content.solr_pi_results =< lib.contentElement
tt_content.solr_pi_results.templateName = SolrPiResults
tt_content.solr_pi_search =< lib.contentElement
tt_content.solr_pi_search.templateName = SolrPiSearch
tt_content.solr_pi_frequentlysearched =< lib.contentElement
tt_content.solr_pi_frequentlysearched.templateName = SolrPiFrequentlySearched

# Anchors for links to a content element (t3://page?uid=12#c345), the way
# fluid_styled_content does it: an empty <a id="c…"> before the element, so no
# element template or layout has to change. Every Content Block type is a
# reference to lib.contentBlock (friendsoftypo3/content-blocks writes
# `tt_content.<type> =< lib.contentBlock`), so this reaches all of them;
# the core types render their id in the ClassicContent layout instead.
lib.contentBlock.stdWrap.prepend = TEXT
lib.contentBlock.stdWrap.prepend.dataWrap = <a id="c{field:uid}"></a>

<?xml version="1.0" encoding="utf-8"?>
<xliff version="2.0" xmlns="urn:oasis:names:tc:xliff:document:2.0" srcLang="en" trgLang="hu">
  <file id="chart-line">
    <unit id="aria.fallback">
      <segment state="final">
        <source>Line chart</source>
        <target>Vonaldiagram</target>
      </segment>
    </unit>
    <unit id="aria.label">
      <segment state="final">
        <source>{title}: line chart of {series}</source>
        <target>{title}: vonaldiagram, adatsor: {series}</target>
      </segment>
    </unit>
    <unit id="aria.summary">
      <segment state="final">
        <source>{title}: {series} trend across {count, plural, one {# point} other {# points}}, from {first} to {last}.</source>
        <target>{title}: {series} alakulása, {count, plural, one {# adatpont} other {# adatpont}}, {first} és {last} között.</target>
      </segment>
    </unit>
    <unit id="table.label_header">
      <segment state="final">
        <source>Period</source>
        <target>Időszak</target>
      </segment>
    </unit>
    <unit id="table.unit_caption">
      <segment state="final">
        <source>values in {unit}</source>
        <target>mértékegység: {unit}</target>
      </segment>
    </unit>
  </file>
</xliff>

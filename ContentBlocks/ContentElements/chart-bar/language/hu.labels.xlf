        <target>Oszlopdiagram</target>
      </segment>
    </unit>
    <unit id="aria.summary">
      <segment state="final">
        <source>{title}: bar chart comparing {count, plural, one {# category} other {# categories}}{measuring}. The full breakdown follows in the data table.</source>
        <target>{title}: oszlopdiagram, {count, plural, one {# kategória} other {# kategória}} összehasonlítása{measuring}. A teljes bontást az adattáblázat tartalmazza.</target>
      </segment>
    </unit>
    <unit id="aria.summary.measuring">
      <segment state="final">
        <source>, measuring {series}</source>
        <target>, mérőszám: {series}</target>
      </segment>
    </unit>
  </file>

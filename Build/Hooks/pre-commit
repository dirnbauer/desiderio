#!/usr/bin/env bash

# Desiderio pre-commit hook.
# Activated by running Build/Scripts/setup-hooks.sh (which sets git
# core.hooksPath = Build/Hooks).
#
# Check rendering code and build dependencies without duplicating the
# generators' own source lists. Documentation-only and test-only commits need
# no asset rebuild.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
if git diff --cached --quiet -- Classes Configuration ContentBlocks Resources \
    package.json package-lock.json; then
  exit 0
fi

echo "pre-commit: rebuilding generated assets to check they stay in sync..." >&2
Build/Scripts/runTests.sh -s assets
if ! git diff --quiet -- Resources/Public; then
  echo "pre-commit: stage the rebuilt files under Resources/Public before committing." >&2
  exit 1
fi
